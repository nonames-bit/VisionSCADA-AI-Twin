# PostgreSQL (TimescaleDB Container)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_ADMIN_USER=twin
PG_ADMIN_PASS=change_me
PG_DB=vision_scada

# Read-Only Database Credentials for LLM Copilot Guardrails
PG_RO_USER=copilot_ro
PG_RO_PASS=copilot_readonly_2026

# Industrial Protocols
OPCUA_ENDPOINT=opc.tcp://0.0.0.0:48420/visionscada/plc/
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
UNS_ROOT=brewcorp/planta_norte/calidad/linea_01/celda_vision_01

# Cloud AI Service (Optional - Graceful Store-and-Forward Fallback if unset/offline)
GEMINI_API_KEY=


# ---- Cloud vision auditor (free tier key: https://aistudio.google.com/apikey) ----
# Empty -> clearly labelled SIMULATED auditor. GEMINI_MAX_RPM keeps calls under the free quota.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RPM=8

# ---- MLOps ----
# MLflow tracking server from docker-compose ("off" disables tracking; the edge keeps working)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_UI_URL=http://localhost:5000
MLFLOW_EXPERIMENT=VisionSCADA_AOI
# MinIO (S3) used by DVC (dataset remote) and MLflow (artifacts)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
